MONGODB_URI=mongodb://localhost:27017/sujon-portfolio
JWT_SECRET=change_this_to_a_random_64_character_string
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Local-only seeding (/api/seed). The route refuses to run unless this is
# "true", and is disabled outright when NODE_ENV=production.
ENABLE_SEED_ROUTE=false
# Credentials the seed route gives the admin user. Never commit real values.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=
