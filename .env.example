MONGODB_URI=mongodb://localhost:27017/sujon-portfolio
JWT_SECRET=change_this_to_a_random_64_character_string
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Local-only seeding (/api/seed). The route refuses to run unless this is
# "true", and is disabled outright when NODE_ENV=production.
ENABLE_SEED_ROUTE=false
# Credentials the seed route gives the admin user. Never commit real values.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=

# --- Contact form email delivery -------------------------------------------
# Without SMTP_USER + SMTP_PASSWORD the form still saves submissions to MongoDB,
# but no email goes out. Defaults target Gmail.
#
# Gmail setup: enable 2-Step Verification on the account, then create an App
# Password at https://myaccount.google.com/apppasswords and paste the 16
# characters below (spaces are fine). A normal account password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sujonhasan171@gmail.com
SMTP_PASSWORD=
# Envelope sender. Gmail rewrites this to SMTP_USER anyway, so leave it unset
# unless you move to a provider that allows a custom From.
SMTP_FROM=
# Where submissions are delivered. Defaults to sujonhasan171@gmail.com.
CONTACT_TO_EMAIL=sujonhasan171@gmail.com
